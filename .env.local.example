# Copia questo file in ".env" (nella stessa cartella di docker-compose.local.yml) e compila i valori.

# Password del database (scegline una lunga e casuale)
POSTGRES_PASSWORD=cambia-questa-password

# Segreto per i token di login (almeno 32 caratteri casuali)
JWT_SECRET=cambia-questo-segreto-lungo-e-casuale

# Account amministratore creato al primo avvio
BOOTSTRAP_ADMIN_EMAIL=admin@restaurant-hub.it
BOOTSTRAP_ADMIN_PASSWORD=password
BOOTSTRAP_RESTAURANT_NAME=Nome del ristorante

# Indirizzo con cui i dispositivi raggiungono il sistema nella rete locale (IP del PC, senza slash finale)
FRONTEND_URL=http://192.168.1.10

# Porta esposta sul PC
HTTP_PORT=80
