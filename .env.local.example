# Copia questo file in ".env" (nella stessa cartella di docker-compose.local.yml) e compila i valori.

# Password del database locale (scegline una lunga e casuale)
POSTGRES_PASSWORD=cambiami

# URL del backend cloud (Cloud Run), senza slash finale
CLOUD_API_URL=https://INDIRIZZO-CLOUD-RUN

# ID del ristorante su cloud: il backend locale accetta solo token di questo ristorante (consigliato)
LOCAL_RISTORANTE_ID=

# Facoltativo: chiave pubblica JWT (base64). Se vuota viene scaricata dal cloud all'avvio
JWT_PUBLIC_KEY=

# Controllo abbonamento: durata cache (minuti) e giorni di tolleranza offline
SUBSCRIPTION_CACHE_MINUTES=1440
SUBSCRIPTION_OFFLINE_GRACE_DAYS=7

# Stampanti Epson ESC/POS in rete (host:porta, porta predefinita 9100)
PRINT_ENABLED=false
PRINTER_BAR=
PRINTER_CUCINA=
PRINTER_PIZZERIA=
# Colonne di stampa: 42 per carta 80mm, 32 per 58mm
PRINT_COLUMNS=42

# Porta esposta sul PC
HTTP_PORT=80
